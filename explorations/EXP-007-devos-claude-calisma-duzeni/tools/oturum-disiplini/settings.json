{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/exp007/oturum-hatirlat.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/exp007/ajan-standart-kapisi.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/exp007/kapsam-kapisi.py"
          }
        ]
      }
    ]
  }
}